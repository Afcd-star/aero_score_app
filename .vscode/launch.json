{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AeroScore Chrome (PocketBase local)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=POCKETBASE_URL=http://127.0.0.1:8090"
      ]
    },
    {
      "name": "AeroScore Emulador Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=POCKETBASE_URL=http://10.0.2.2:8090"
      ]
    }
  ]
}